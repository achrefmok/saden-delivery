# PostgreSQL (Vercel → Storage → Neon Postgres crée cette variable automatiquement)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Secret pour signer les sessions (chaîne longue et aléatoire)
JWT_SECRET=change-me-to-a-long-random-string
# Optionnel
AGENCY_CITY=Gafsa
DELIVERY_FEE=7
DRIVER_SHARE=2
